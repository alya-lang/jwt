# Public Constructor & Helpers
# ═══════════════════════════════════════════════════════════════

## Creates a new empty JwtBuilder instance.
##
## ### Returns
## The new `JwtBuilder` instance.
pub function builder() -> JwtBuilder
    return JwtBuilder {
        claims_str: "",
        claim_count: 0
    }
end

## Adds a string key-value claim to the builder.
##
## ### Parameters
## - `b`: Target `JwtBuilder` instance.
## - `key`: Claim key string.
## - `val`: Claim value string.
##
## ### Returns
## The updated builder instance.
pub function builder_claim_str(b: JwtBuilder, key: string, val: string) -> JwtBuilder
    return _builder_claim_str(b, key, val)
end

## Adds an integer key-value claim to the builder.
##
## ### Parameters
## - `b`: Target `JwtBuilder` instance.
## - `key`: Claim key string.
## - `val`: Claim value integer.
##
## ### Returns
## The updated builder instance.
pub function builder_claim_int(b: JwtBuilder, key: string, val: int) -> JwtBuilder
    return _builder_claim_int(b, key, val)
end

## Adds a boolean key-value claim to the builder (`1` is true).
##
## ### Parameters
## - `b`: Target `JwtBuilder` instance.
## - `key`: Claim key string.
## - `val`: Claim flag integer.
##
## ### Returns
## The updated builder instance.
pub function builder_claim_bool(b: JwtBuilder, key: string, val: int) -> JwtBuilder
    return _builder_claim_bool(b, key, val)
end

## Sets the standard `sub` (subject) claim on the builder.
##
## ### Parameters
## - `b`: Target `JwtBuilder` instance.
## - `sub`: Subject string.
##
## ### Returns
## The updated builder instance.
pub function builder_subject(b: JwtBuilder, sub: string) -> JwtBuilder
    return _builder_subject(b, sub)
end

## Sets the standard `iss` (issuer) claim on the builder.
##
## ### Parameters
## - `b`: Target `JwtBuilder` instance.
## - `iss`: Issuer string.
##
## ### Returns
## The updated builder instance.
pub function builder_issuer(b: JwtBuilder, iss: string) -> JwtBuilder
    return _builder_issuer(b, iss)
end

## Sets the standard `aud` (audience) claim on the builder.
##
## ### Parameters
## - `b`: Target `JwtBuilder` instance.
## - `aud`: Audience string.
##
## ### Returns
## The updated builder instance.
pub function builder_audience(b: JwtBuilder, aud: string) -> JwtBuilder
    return _builder_audience(b, aud)
end

## Sets the standard `iat` (issued at) claim on the builder.
##
## ### Parameters
## - `b`: Target `JwtBuilder` instance.
## - `iat_sec`: Issued-at timestamp. Defaults to `0` (now).
##
## ### Returns
## The updated builder instance.
pub function builder_issued_at(b: JwtBuilder, iat_sec: int = 0) -> JwtBuilder
    return _builder_issued_at(b, iat_sec)
end

## Sets the standard `exp` (expires at) timestamp claim on the builder.
##
## ### Parameters
## - `b`: Target `JwtBuilder` instance.
## - `exp_timestamp`: Expiry timestamp integer.
##
## ### Returns
## The updated builder instance.
pub function builder_expires_at(b: JwtBuilder, exp_timestamp: int) -> JwtBuilder
    return _builder_expires_at(b, exp_timestamp)
end

## Sets `iat` to now and `exp` to now plus a duration on the builder.
##
## ### Parameters
## - `b`: Target `JwtBuilder` instance.
## - `duration_sec`: Lifetime seconds integer.
##
## ### Returns
## The updated builder instance.
pub function builder_expires_in(b: JwtBuilder, duration_sec: int) -> JwtBuilder
    return _builder_expires_in(b, duration_sec)
end

## Sets the standard `nbf` (not before) timestamp claim on the builder.
##
## ### Parameters
## - `b`: Target `JwtBuilder` instance.
## - `nbf_timestamp`: Not-before timestamp integer.
##
## ### Returns
## The updated builder instance.
pub function builder_not_before(b: JwtBuilder, nbf_timestamp: int) -> JwtBuilder
    return _builder_not_before(b, nbf_timestamp)
end

## Sets the standard `jti` (JWT ID) unique identifier claim on the builder.
##
## ### Parameters
## - `b`: Target `JwtBuilder` instance.
## - `jti`: Identifier string.
##
## ### Returns
## The updated builder instance.
pub function builder_jwt_id(b: JwtBuilder, jti: string) -> JwtBuilder
    return _builder_jwt_id(b, jti)
end

## Serializes the builder claims to a JSON object string.
##
## ### Parameters
## - `b`: Target `JwtBuilder` instance.
##
## ### Returns
## The JSON object string.
pub function builder_to_json(b: JwtBuilder) -> string
    return _builder_to_json(b)
end
