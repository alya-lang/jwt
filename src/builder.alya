# JWT Fluent Builder API
# Part of the Alya Language package ecosystem (https://github.com/alya-lang)

import "std/time"
import "std/json"

struct JwtBuilder
    claims_str
    claim_count
end

function builder()
    return JwtBuilder {
        claims_str: "",
        claim_count: 0
    }
end

function _builder_add_raw(b, pair_str)
    if b.claim_count > 0
        b.claims_str = b.claims_str + ", " + pair_str
    else
        b.claims_str = pair_str
    end
    b.claim_count += 1
    return b
end

function builder_claim_str(b, key, val)
    return _builder_add_raw(b, "\"" + json_escape(key) + "\": \"" + json_escape(val) + "\"")
end

function builder_claim_int(b, key, val)
    return _builder_add_raw(b, "\"" + json_escape(key) + "\": " + str(val))
end

function builder_claim_bool(b, key, val)
    let s = "false"
    if val == 1
        s = "true"
    end
    return _builder_add_raw(b, "\"" + json_escape(key) + "\": " + s)
end

function builder_subject(b, sub)
    return builder_claim_str(b, "sub", sub)
end

function builder_issuer(b, iss)
    return builder_claim_str(b, "iss", iss)
end

function builder_audience(b, aud)
    return builder_claim_str(b, "aud", aud)
end

function builder_issued_at(b, iat_sec = 0)
    let t = iat_sec
    if t == 0
        t = time()
    end
    return builder_claim_int(b, "iat", t)
end

function builder_expires_at(b, exp_timestamp)
    return builder_claim_int(b, "exp", exp_timestamp)
end

function builder_expires_in(b, duration_sec)
    let now_sec = time()
    builder_issued_at(b, now_sec)
    return builder_expires_at(b, now_sec + duration_sec)
end

function builder_not_before(b, nbf_timestamp)
    return builder_claim_int(b, "nbf", nbf_timestamp)
end

function builder_jwt_id(b, jti)
    return builder_claim_str(b, "jti", jti)
end

function builder_to_json(b)
    return "{" + b.claims_str + "}"
end
