## # jwt/types
##
## Types and data structures for the jwt package.
## Part of the Alya Language package ecosystem (https://github.com/alya-lang).
##
## Defines algorithm and error discriminators, the decoded token model,
## verification options, and token parsing helpers.

## Public enumeration of supported JWT algorithms.
pub enum JwtAlgorithm
    HS256 = 1,
    HS384 = 2,
    HS512 = 3
end

## Public enumeration of standard JWT error codes.
pub enum JwtErrorCode
    NONE = 0,
    MALFORMED_TOKEN = 1,
    MALFORMED_JSON = 2,
    MISSING_ALG = 3,
    UNSUPPORTED_ALG = 4,
    INVALID_SIGNATURE = 5,
    TOKEN_EXPIRED = 6,
    TOKEN_NOT_YET_VALID = 7,
    INVALID_ISSUER = 8,
    INVALID_AUDIENCE = 9
end

## Public JWT token representation with decoded parts and status.
##
## ### Fields
## - `raw`: Original token string.
## - `header`: Decoded header map (or null when malformed).
## - `payload`: Decoded payload map (or null when malformed).
## - `signature`: Signature segment string.
## - `valid`: `1` when verified, `0` otherwise.
## - `error`: Error message string (empty when valid).
pub struct JwtToken
    raw: string,
    header,
    payload,
    signature: string,
    valid: int,
    error: string
end

## Checks whether this token is valid.
##
## ### Parameters
## - `self`: The target `JwtToken` instance.
##
## ### Returns
## `1` when valid, `0` otherwise.
pub function JwtToken.is_valid(self: JwtToken) -> int
    return self.valid == 1
end

## Retrieves a claim value when present on a valid token.
##
## ### Parameters
## - `self`: The target `JwtToken` instance.
## - `claim_name`: Claim key string.
##
## ### Returns
## The claim string, or null when missing or invalid.
pub function JwtToken.get_claim(self: JwtToken, claim_name: string)
    if self.valid == 1 and self.payload is not null and (claim_name in self.payload)
        return str_from_ptr(self.payload[claim_name])
    end
    return null
end

## Public verification options model.
##
## ### Fields
## - `leeway`: Clock-skew tolerance in seconds.
## - `issuer`: Expected issuer string (empty disables the check).
## - `audience`: Expected audience string (empty disables the check).
## - `ignore_expiration`: `1` skips expiry validation, `0` enforces it.
## - `current_time`: Override unix time (`0` uses system time).
pub struct JwtVerifyOptions
    leeway: int,
    issuer: string,
    audience: string,
    ignore_expiration: int,
    current_time: int
end

## Sets a custom leeway in seconds, returning the updated options.
##
## ### Parameters
## - `self`: The target `JwtVerifyOptions` instance.
## - `sec`: Leeway seconds integer.
##
## ### Returns
## The updated options instance.
pub function JwtVerifyOptions.with_leeway(self: JwtVerifyOptions, sec: int) -> JwtVerifyOptions
    self.leeway = sec
    return self
end

## Sets the expected issuer, returning the updated options.
##
## ### Parameters
## - `self`: The target `JwtVerifyOptions` instance.
## - `iss`: Issuer string.
##
## ### Returns
## The updated options instance.
pub function JwtVerifyOptions.with_issuer(self: JwtVerifyOptions, iss: string) -> JwtVerifyOptions
    self.issuer = iss
    return self
end

## Sets the expected audience, returning the updated options.
##
## ### Parameters
## - `self`: The target `JwtVerifyOptions` instance.
## - `aud`: Audience string.
##
## ### Returns
## The updated options instance.
pub function JwtVerifyOptions.with_audience(self: JwtVerifyOptions, aud: string) -> JwtVerifyOptions
    self.audience = aud
    return self
end

## Factory constructing a `JwtToken` from decoded parts.
##
## ### Parameters
## - `raw`: Original token string.
## - `header`: Decoded header map (or null).
## - `payload`: Decoded payload map (or null).
## - `signature`: Signature segment string.
## - `valid`: `1` when verified. Defaults to `1`.
## - `error`: Error message. Defaults to `""`.
##
## ### Returns
## The new `JwtToken` instance.
pub function jwt_token_new(raw: string, header, payload, signature: string, valid: int = 1, error: string = "") -> JwtToken
    return JwtToken {
        raw: raw,
        header: header,
        payload: payload,
        signature: signature,
        valid: valid,
        error: error
    }
end

## Factory constructing verification options with sensible defaults.
##
## ### Parameters
## - `leeway`: Clock-skew tolerance. Defaults to `0`.
## - `issuer`: Expected issuer. Defaults to `""`.
## - `audience`: Expected audience. Defaults to `""`.
## - `ignore_expiration`: `1` skips expiry validation. Defaults to `0`.
## - `current_time`: Override unix time. Defaults to `0`.
##
## ### Returns
## The new `JwtVerifyOptions` instance.
pub function jwt_options_new(leeway: int = 0, issuer: string = "", audience: string = "", ignore_expiration: int = 0, current_time: int = 0) -> JwtVerifyOptions
    return JwtVerifyOptions {
        leeway: leeway,
        issuer: issuer,
        audience: audience,
        ignore_expiration: ignore_expiration,
        current_time: current_time
    }
end

# Internal whitespace trimmer (private to module).
function _jwt_trim(s: string) -> string
    let slen = len(s)
    if slen == 0
        return ""
    end
    let start_idx = 0
    while start_idx < slen
        let ch = char_at(s, start_idx)
        if ch != " " and ch != "\t" and ch != "\r" and ch != "\n"
            break
        end
        start_idx += 1
    end
    if start_idx >= slen
        return ""
    end
    let end_idx = slen - 1
    while end_idx >= start_idx
        let ch = char_at(s, end_idx)
        if ch != " " and ch != "\t" and ch != "\r" and ch != "\n"
            break
        end
        end_idx -= 1
    end
    return substring(s, start_idx, end_idx - start_idx + 1)
end

## Splits a token string on dots (`header.payload.signature`).
##
## ### Parameters
## - `token`: Token string.
##
## ### Returns
## Array of segment strings.
pub function split_parts(token: string) -> array
    let s = _jwt_trim(token)
    let slen = len(s)
    let parts = []
    let start = 0
    let i = 0

    while i < slen
        if char_at(s, i) == "."
            parts.push(substring(s, start, i - start))
            start = i + 1
        end
        i += 1
    end

    if start <= slen
        parts.push(substring(s, start, slen - start))
    end

    return parts
end
