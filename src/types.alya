# Types and data structures for jwt package
# Part of the Alya Language package ecosystem (https://github.com/alya-lang)

# Public enumeration of supported JWT algorithms
pub enum JwtAlgorithm
    HS256 = 1,
    HS384 = 2,
    HS512 = 3
end

# Public JWT token representation
pub struct JwtToken
    raw,
    header,
    payload,
    signature,
    valid,
    error
end

# Struct method: checks if token is valid
pub function JwtToken.is_valid(self)
    return self.valid == 1
end

# Struct method: retrieves a claim value if present
pub function JwtToken.get_claim(self, claim_name)
    if self.valid == 1 and self.payload is not null and (claim_name in self.payload)
        return str_from_ptr(self.payload[claim_name])
    end
    return null
end

# Public verification options model
pub struct JwtVerifyOptions
    leeway,
    issuer,
    audience,
    ignore_expiration,
    current_time
end

# Struct method: sets custom leeway in seconds
pub function JwtVerifyOptions.with_leeway(self, sec)
    self.leeway = sec
    return self
end

# Struct method: sets expected issuer
pub function JwtVerifyOptions.with_issuer(self, iss)
    self.issuer = iss
    return self
end

# Struct method: sets expected audience
pub function JwtVerifyOptions.with_audience(self, aud)
    self.audience = aud
    return self
end

# Public token constructor factory
pub function jwt_token_new(raw, header, payload, signature, valid = 1, error = "")
    return JwtToken {
        raw: raw,
        header: header,
        payload: payload,
        signature: signature,
        valid: valid,
        error: error
    }
end

# Public verification options factory
pub function jwt_options_new(leeway = 0, issuer = "", audience = "", ignore_expiration = 0, current_time = 0)
    return JwtVerifyOptions {
        leeway: leeway,
        issuer: issuer,
        audience: audience,
        ignore_expiration: ignore_expiration,
        current_time: current_time
    }
end

# Internal whitespace trimmer (private to module)
function _jwt_trim(s)
    let slen = len(s)
    if slen == 0
        return ""
    end
    let start_idx = 0
    while start_idx < slen
        let ch = char_at(s, start_idx)
        if ch != " " and ch != "\t" and ch != "\r" and ch != "\n"
            break
        end
        start_idx += 1
    end
    if start_idx >= slen
        return ""
    end
    let end_idx = slen - 1
    while end_idx >= start_idx
        let ch = char_at(s, end_idx)
        if ch != " " and ch != "\t" and ch != "\r" and ch != "\n"
            break
        end
        end_idx -= 1
    end
    return substring(s, start_idx, end_idx - start_idx + 1)
end

# Public token string splitter (splits header.payload.signature)
pub function split_parts(token)
    let s = _jwt_trim(token)
    let slen = len(s)
    let parts = []
    let start = 0
    let i = 0

    while i < slen
        if char_at(s, i) == "."
            parts.push(substring(s, start, i - start))
            start = i + 1
        end
        i += 1
    end

    if start <= slen
        parts.push(substring(s, start, slen - start))
    end

    return parts
end

# Backward-compatible alias for split_parts
pub function _jwt_split_parts(token)
    return split_parts(token)
end
