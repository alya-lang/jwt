## # jwt/verifier
##
## JWT claims and rules verification.
## Part of the Alya Language package ecosystem (https://github.com/alya-lang).
##
## Validates `exp`, `nbf`, `iss`, and `aud` claims against leeway and options.

import "std/time"

## Verifies standard claims, returning an error message or `""` when valid.
##
## ### Parameters
## - `payload`: Decoded payload map.
## - `options`: `JwtVerifyOptions` instance.
##
## ### Returns
## An error message string, or `""` when all checks pass.
pub function verify_claims(payload, options) -> string
    let opts = options
    let current_sec = if opts.current_time == 0 then time() else opts.current_time
    let leeway = opts.leeway

    # 1. Expiration check (exp)
    if opts.ignore_expiration == 0 and ("exp" in payload)
        let exp_val = payload["exp"]
        if current_sec - leeway > exp_val
            return "Token expired"
        end
    end

    # 2. Not Before check (nbf)
    if "nbf" in payload
        let nbf_val = payload["nbf"]
        if current_sec + leeway < nbf_val
            return "Token not yet valid (nbf)"
        end
    end

    # 3. Issuer check (iss)
    if len(opts.issuer) > 0
        if ("iss" not in payload) or payload["iss"] != opts.issuer
            return "Invalid issuer"
        end
    end

    # 4. Audience check (aud)
    if len(opts.audience) > 0
        if ("aud" not in payload) or payload["aud"] != opts.audience
            return "Invalid audience"
        end
    end

    return ""
end
