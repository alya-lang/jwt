# jwt - JSON Web Token (RFC 7519) Library for Alya
# Part of the Alya Language package ecosystem (https://github.com/alya-lang)

import "crypto" as crypto
import "./types.alya"
import "./core/verifier.alya"
import "./builder.alya"
import "std/json"
import "std/time"

# ═══════════════════════════════════════════════════════════════
# Struct Methods
# ═══════════════════════════════════════════════════════════════

## Signs the builder's accumulated claims with secret.
pub function JwtBuilder.sign(self, secret)
    return encode_raw(builder_to_json(self), secret)
end

# ═══════════════════════════════════════════════════════════════
# Internal Serialization Helpers (Private to module)
# ═══════════════════════════════════════════════════════════════

function _map_to_json(m)
    let res = "{"
    let first = true
    for key, val in m
        if not first
            res += ", "
        else
            first = false
        end
        let escaped_key = json_escape(key)
        when key
            is "exp", "iat", "nbf" then
                res += "\"" + escaped_key + "\": " + str(val)
            is "admin", "active" then
                let bool_str = if val == 1 then "true" else "false"
                res += "\"" + escaped_key + "\": " + bool_str
            else
                if len(key) >= 3 and substring(key, 0, 3) == "is_"
                    let bool_str = if val == 1 then "true" else "false"
                    res += "\"" + escaped_key + "\": " + bool_str
                else
                    res += "\"" + escaped_key + "\": \"" + json_escape(val) + "\""
                end
        end
    end
    res += "}"
    return res
end

# ═══════════════════════════════════════════════════════════════
# Public API Facade
# ═══════════════════════════════════════════════════════════════

## Encodes raw JSON payload string and signs with secret using HS256.
pub function encode_raw(payload_json_str, secret, header_json_str = "{\"alg\":\"HS256\",\"typ\":\"JWT\"}")
    let header_b64 = crypto::base64url_encode(header_json_str)
    let payload_b64 = crypto::base64url_encode(payload_json_str)
    let signing_input = header_b64 + "." + payload_b64

    let k_bytes = crypto::str_to_bytes(secret)
    let m_bytes = crypto::str_to_bytes(signing_input)
    let sig_bytes = crypto::hmac_sha256_bytes(k_bytes, m_bytes)
    let sig_b64 = crypto::base64url_encode_bytes(sig_bytes)

    return signing_input + "." + sig_b64
end

## Encodes a Map payload and signs it with secret using HMAC-SHA256 (HS256).
pub function encode(payload, secret)
    let payload_json = _map_to_json(payload)
    return encode_raw(payload_json, secret)
end

## Encodes a Map payload with custom header map and signs with secret.
pub function encode_with_header(payload, secret, custom_header)
    let header_json = _map_to_json(custom_header)
    let payload_json = _map_to_json(payload)
    return encode_raw(payload_json, secret, header_json)
end

## Creates a token with auto-populated 'iat' and 'exp' claims from a Map payload.
pub function sign(payload, secret, expires_in_sec = 3600)
    let b = builder()
    let now_sec = time()
    builder_issued_at(b, now_sec)
    builder_expires_at(b, now_sec + expires_in_sec)

    for key, val in payload
        when key
            is "exp", "iat" then
                # Skip already populated claims
            else
                builder_claim_str(b, key, val)
        end
    end

    return builder_sign(b, secret)
end

## Decodes a JWT token without signature verification into a JwtToken struct.
pub function decode(token)
    let parts = split_parts(token)
    if len(parts) != 3
        return jwt_token_new(token, null, null, "", 0, "Malformed token: expected 3 parts")
    end

    let header_raw = crypto::base64url_decode(parts[0])
    let payload_raw = crypto::base64url_decode(parts[1])
    let signature = parts[2]

    let header = json_parse(header_raw)
    let payload = json_parse(payload_raw)

    if header is null or payload is null
        return jwt_token_new(token, header, payload, signature, 0, "Malformed JSON in token")
    end

    return jwt_token_new(token, header, payload, signature, 1, "")
end

## Verifies HMAC-SHA256 signature and validates standard claims with custom options.
pub function verify_with_options(token, secret, options)
    let parts = split_parts(token)
    if len(parts) != 3
        return jwt_token_new(token, null, null, "", 0, "Malformed token: expected 3 parts")
    end

    let header_raw = crypto::base64url_decode(parts[0])
    let payload_raw = crypto::base64url_decode(parts[1])
    let signature = parts[2]

    let header = json_parse(header_raw)
    if header is null
        return jwt_token_new(token, null, null, signature, 0, "Malformed header JSON")
    end

    if "alg" not in header
        return jwt_token_new(token, header, null, signature, 0, "Missing 'alg' claim in header")
    end

    let alg = header["alg"]
    when alg
        is "HS256" then
            # Supported algorithm
        else
            return jwt_token_new(token, header, null, signature, 0, "Unsupported algorithm: " + alg)
    end

    let payload = json_parse(payload_raw)
    if payload is null
        return jwt_token_new(token, header, null, signature, 0, "Malformed payload JSON")
    end

    # 1. Verify HMAC-SHA256 signature
    let signing_input = parts[0] + "." + parts[1]
    let k_bytes = crypto::str_to_bytes(secret)
    let m_bytes = crypto::str_to_bytes(signing_input)
    let sig_bytes = crypto::hmac_sha256_bytes(k_bytes, m_bytes)
    let expected_sig = crypto::base64url_encode_bytes(sig_bytes)

    if crypto::constant_time_eq(signature, expected_sig) == 0
        return jwt_token_new(token, header, payload, signature, 0, "Invalid signature")
    end

    # 2. Verify claims
    let claim_err = verify_claims(payload, options)
    if len(claim_err) > 0
        return jwt_token_new(token, header, payload, signature, 0, claim_err)
    end

    return jwt_token_new(token, header, payload, signature, 1, "")
end

## Verifies HMAC-SHA256 signature and standard claims using default options.
pub function verify(token, secret)
    let default_opts = jwt_options_new()
    return verify_with_options(token, secret, default_opts)
end

## Returns 1 if token signature and claims are valid, 0 otherwise.
pub function is_valid(token, secret)
    let res = verify(token, secret)
    return res.valid == 1
end

## Returns 1 if token signature and claims match given options, 0 otherwise.
pub function is_valid_with_options(token, secret, options)
    let res = verify_with_options(token, secret, options)
    return res.valid == 1
end

## Returns 1 if token is expired (now > exp), 0 otherwise.
pub function is_expired(token)
    let t = decode(token)
    if t.valid == 0
        return 1
    end
    if t.payload is not null and ("exp" in t.payload)
        return time() > t.payload["exp"]
    end
    return 0
end

## Extracts a specific claim from token payload without full signature verification.
pub function get_claim(token, claim_name)
    let t = decode(token)
    if t.valid == 1 and t.payload is not null and (claim_name in t.payload)
        return str_from_ptr(t.payload[claim_name])
    end
    return null
end

## Creates a JwtVerifyOptions configuration struct.
pub function options(leeway = 0, issuer = "", audience = "", ignore_expiration = 0, current_time = 0)
    return jwt_options_new(leeway, issuer, audience, ignore_expiration, current_time)
end

## Signs using an assembled JwtBuilder instance.
pub function builder_sign(b, secret)
    return encode_raw(builder_to_json(b), secret)
end

# ═══════════════════════════════════════════════════════════════
# Exported Low-Level Utilities
# ═══════════════════════════════════════════════════════════════

## Computes SHA-256 hex digest of string message.
pub function sha256(msg)
    return crypto::sha256(msg)
end

## Computes HMAC-SHA256 hex digest using secret key.
pub function hmac_sha256(secret, msg)
    return crypto::hmac_sha256(secret, msg)
end

## Encodes a string to RFC 7515 Base64URL string without padding.
pub function b64url_encode(s)
    return crypto::base64url_encode(s)
end

## Decodes an RFC 7515 Base64URL string.
pub function b64url_decode(s)
    return crypto::base64url_decode(s)
end
