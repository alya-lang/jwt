# Benchmark suite for jwt
import "std/bench"
import "../src/lib.alya" as jwt

function main()
    let runner = bench_runner("jwt Micro-Benchmarks (RFC 7519)")

    let payload = {"sub": "user_42", "role": "admin"}
    let secret = "production-benchmark-secret-key-12345"
    let token = jwt::encode(payload, secret)

    # 1. Token Decoding (Base64URL + JSON parse)
    bench_start(runner, 10000)
    let i = 0
    while i < 10000
        jwt::decode(token)
        i += 1
    end
    bench_stop(runner, "decode() 10k")

    # 2. Token Verification (HMAC-SHA256 + claims)
    bench_start(runner, 5000)
    let j = 0
    while j < 5000
        jwt::verify(token, secret)
        j += 1
    end
    bench_stop(runner, "verify() 5k")

    # 3. Token Encoding / Signing (Map -> JSON -> HMAC-SHA256 -> B64URL)
    bench_start(runner, 5000)
    let k = 0
    while k < 5000
        jwt::encode(payload, secret)
        k += 1
    end
    bench_stop(runner, "encode() 5k")

    # 4. Fluent Builder API + Sign
    bench_start(runner, 5000)
    let m = 0
    while m < 5000
        let b = jwt::builder()
        jwt::builder_subject(b, "user_42")
        jwt::builder_issuer(b, "auth.alya.lang")
        jwt::builder_audience(b, "api.alya.lang")
        jwt::builder_expires_in(b, 3600)
        jwt::builder_sign(b, secret)
        m += 1
    end
    bench_stop(runner, "builder() + sign 5k")

    # 5. Raw HMAC-SHA256 Primitives
    let signing_input = "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiJ1c2VyXzQyIiwicm9sZSI6ImFkbWluIn0"
    bench_start(runner, 5000)
    let n = 0
    while n < 5000
        jwt::hmac_sha256(secret, signing_input)
        n += 1
    end
    bench_stop(runner, "hmac_sha256() 5k")

    # 6. Base64URL Encoding & Decoding
    let raw_text = "The quick brown fox jumps over the lazy dog"
    bench_start(runner, 20000)
    let p = 0
    while p < 20000
        let b64 = jwt::b64url_encode(raw_text)
        jwt::b64url_decode(b64)
        p += 1
    end
    bench_stop(runner, "b64url_encode + decode 20k")

    bench_summary(runner)
end

main()
